# Copia este archivo como .env y completa solamente tus valores privados.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
APP_PUBLIC_URL=http://127.0.0.1:5173

# Atlas (privado). La aplicación SIEMPRE usa la base "myspa2".
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@HOST.mongodb.net/myspa2?retryWrites=true&w=majority
MONGODB_DB_NAME=myspa

# Correo opcional: requerido para el envío real de avisos y recuperación.
# Para recuperación sin colección passwordResets, genera un secreto propio:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RESET_TOKEN_SECRET=

# Minutos después del FIN de la cita para marcar automáticamente NO_ASISTIO.
MYSPA_NO_SHOW_GRACE_MINUTES=120

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcional: primera ejecución del seed (no se guarda como código).
SEED_ADMIN_PASSWORD=

# Opcional: Google Maps JavaScript API + Places API (New). CLAVE DE NAVEGADOR, restringida por HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
